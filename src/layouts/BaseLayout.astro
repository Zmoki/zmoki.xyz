---
import "@/styles/global.css";
import { getEntry } from "astro:content";
import PostHog from "@/components/posthog.astro";
import Footer from "@/components/Footer.astro";
import TopNav from "@/components/TopNav.astro";

export interface Props {
  title: string;
  description?: string;
  publishDate?: Date;
  contentModifiedDate?: Date;
  showTopNav?: boolean;
}

const {
  title,
  description = "A digital garden of ideas, art, and research",
  publishDate,
  contentModifiedDate,
  showTopNav = true,
} = Astro.props;

const isProduction = import.meta.env.PROD;
const analyticsEnabled = import.meta.env.PUBLIC_ANALYTICS_ENABLED !== "false";

const siteBaseUrl = Astro.site;
const currentBaseUrl = isProduction ? siteBaseUrl : `http://localhost:${Astro.url.port}`;

const isPageArticle = publishDate && contentModifiedDate;

const canonicalURL = new URL(Astro.url.pathname, siteBaseUrl).toString();

// The og masters mirror the pages tree: a page's card lives at
// src/content/og/{trimmed pathname}.svg (index.svg for the homepage, served
// as /og/site.png). Pages without their own master share the hand-designed
// fallback master (fallback.svg, served as /og/fallback.png). In dev, any
// unmatched URL renders the 404 page under the requested pathname, so a 404
// response always uses the 404 card.
const trimmedPathname = Astro.url.pathname.replace(/^\/+|\/+$/g, "");
const cardId =
  Astro.response.status === 404 ? "404" : trimmedPathname === "" ? "index" : trimmedPathname;
const ogCard = await getEntry("og", cardId);
const resolvedCard = ogCard ?? (await getEntry("og", "fallback"));
if (!resolvedCard) {
  throw new Error(
    `Page "${Astro.url.pathname}" has no OG card and the shared src/content/og/fallback.svg is missing`,
  );
}
const pageImagePath =
  cardId === "index" ? "/og/site.png" : ogCard ? `/og/${cardId}.png` : "/og/fallback.png";
const pageImageWideUrl = new URL(pageImagePath, currentBaseUrl).toString();
const pageImageSquareUrl = new URL(
  pageImagePath.replace("/og/", "/og/square/"),
  currentBaseUrl,
).toString();

// Alt text from the serving master's <desc> — the page's own card, or the
// shared fallback card when the page has none.
const pageImageAlt = resolvedCard.data.alt ?? "";
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Mono:wght@100..900&family=Noto+Sans:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="max-image-preview:large" />
    <link rel="canonical" href={canonicalURL} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="RSS Feed"
      href={new URL("rss.xml", siteBaseUrl).toString()}
    />

    <!-- Open Graph meta tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={isPageArticle ? "article" : "website"} />
    <meta property="og:site_name" content="Zarema's Digital Garden" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={pageImageWideUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageImageAlt} />
    <meta property="og:image" content={pageImageSquareUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:alt" content={pageImageAlt} />
    {
      isPageArticle && (
        <meta property="article:published_time" content={publishDate.toISOString()} />
      )
    }
    {
      isPageArticle && (
        <meta property="article:modified_time" content={contentModifiedDate.toISOString()} />
      )
    }
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:image" content={pageImageWideUrl} />
    <meta property="twitter:image:alt" content={pageImageAlt} />

    {analyticsEnabled && <PostHog />}
  </head>
  <body
    class="min-h-full bg-zmoki-bg font-sans text-lg leading-tight tracking-tight text-zmoki-ink xl:text-xl"
  >
    {showTopNav && <TopNav />}
    <slot />
    <Footer />
  </body>
</html>
