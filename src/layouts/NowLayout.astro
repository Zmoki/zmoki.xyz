---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Prose from "@/components/Prose.astro";
import Time from "@/components/Time.astro";

const {
  title,
  description,
  publishDate: rawPublishDate,
  contentModifiedDate: rawcCntentModifiedDate,
} = Astro.props.frontmatter;

const publishDate = new Date(rawPublishDate);
const contentModifiedDate = new Date(rawcCntentModifiedDate);
---

<BaseLayout
  title={title}
  description={description}
  publishDate={publishDate}
  contentModifiedDate={contentModifiedDate}
>
  <section class="bg-zmoki-surface px-4 sm:gap-6 md:gap-8 md:px-8 lg:gap-12 lg:px-12 xl:pb-32">
    <!-- Now Header -->
    <header
      class="grid grid-cols-1 gap-4 py-12 text-[0.65rem] sm:gap-6 md:grid-cols-[1fr_55ch] md:gap-12 lg:grid-cols-[1fr_80ch] lg:gap-20 xl:py-20"
    >
      <div class="flex flex-col gap-4 lg:gap-8">
        <h1 class="text-4xl font-semibold md:text-5xl xl:text-6xl" set:html={title} />
        {description && <p class="text-xl lg:text-3xl xl:text-4xl" set:html={description} />}
      </div>
      <div class="grid grid-cols-1 gap-4 sm:gap-6">
        <figure>
          <Image src="/og/cover/now.png" alt="" width={1200} height={675} class="max-w-full" />
        </figure>

        <aside
          class="flex flex-row flex-wrap justify-evenly gap-2 font-mono uppercase tracking-normal opacity-70"
        >
          <p>Updated on <Time datetime={contentModifiedDate} /></p>
        </aside>
      </div>
    </header>

    <!-- Now Content -->
    <Prose>
      <slot />
    </Prose>
  </section>
</BaseLayout>
