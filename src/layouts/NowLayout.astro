---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Prose from "@/components/Prose.astro";
import Time from "@/components/Time.astro";

const {
  title,
  description,
  publishDate: rawPublishDate,
  contentModifiedDate: rawcCntentModifiedDate,
} = Astro.props.frontmatter;

const publishDate = new Date(rawPublishDate);
const contentModifiedDate = new Date(rawcCntentModifiedDate);
---

<BaseLayout
  title={title}
  description={description}
  publishDate={publishDate}
  contentModifiedDate={contentModifiedDate}
>
  <section class="space-y-8 bg-zmoki-surface">
    <!-- Now Header -->
    <header
      class="grid grid-cols-1 gap-6 px-6 py-8 md:px-12 lg:grid-cols-[60ch_1fr] lg:gap-x-24 lg:gap-y-6 lg:pb-12 lg:pt-24 xl:px-16"
    >
      <h1 class="text-4xl font-semibold xl:text-6xl" set:html={title} />
      {description && <p class="text-2xl lg:col-start-1 xl:text-3xl" set:html={description} />}
      <p
        class="flex flex-col gap-2 self-start font-mono text-xs uppercase tracking-normal opacity-70 lg:col-start-2 lg:row-start-2 xl:text-sm"
      >
        <span>Updated on <Time datetime={contentModifiedDate} /></span>
      </p>
    </header>

    <!-- Now Content -->
    <Prose>
      <slot />
    </Prose>
  </section>
</BaseLayout>
