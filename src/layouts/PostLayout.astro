---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Prose from "@/components/Prose.astro";
import Time from "@/components/Time.astro";

export interface Props {
  title: string;
  description?: string;
  publishDate: Date;
  contentModifiedDate: Date;
}

const { title, description, publishDate, contentModifiedDate } = Astro.props;
const isContentModified = contentModifiedDate.getTime() > publishDate.getTime();
---

<BaseLayout
  title={title}
  description={description}
  publishDate={publishDate}
  contentModifiedDate={contentModifiedDate}
  surfaceBackground
  navClass="lg:pl-12 xl:pl-16"
>
  <article class="space-y-8">
    <!-- Post Header -->
    <header
      class="grid grid-cols-1 gap-6 px-6 py-8 md:px-12 lg:grid-cols-[60ch_1fr] lg:gap-x-24 lg:gap-y-6 lg:pb-12 lg:pt-24 xl:px-16"
    >
      <h1 class="text-4xl font-semibold xl:text-6xl" set:html={title} />
      {description && <p class="text-2xl lg:col-start-1 xl:text-3xl" set:html={description} />}
      <p
        class="flex flex-col gap-2 self-start font-mono text-xs uppercase tracking-normal opacity-70 lg:col-start-2 lg:row-start-2 xl:text-sm"
      >
        {
          isContentModified ? (
            <>
              <span>
                Updated on <Time datetime={contentModifiedDate} />
              </span>
              <span>
                [published on <Time datetime={publishDate} />]
              </span>
            </>
          ) : (
            <span>
              Published on <Time datetime={publishDate} />
            </span>
          )
        }
        <span>Author: Zarema Khalilova</span>
      </p>
    </header>

    <!-- Post Content -->
    <Prose>
      <slot />
    </Prose>
  </article>
</BaseLayout>
