---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Time from "@/components/Time.astro";

const { title, description, publishDate, contentModifiedDate } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  publishDate={publishDate}
  contentModifiedDate={contentModifiedDate}
  surfaceBackground
  navClass="lg:pl-12 xl:pl-16"
>
  <section class="space-y-8 p-4 lg:p-8 lg:pl-12 xl:pl-16">
    <!-- Legal Header -->
    <header
      class="grid grid-cols-1 gap-6 py-8 lg:grid-cols-[minmax(0,42rem)_auto] lg:gap-x-12 lg:gap-y-6"
    >
      <h1 class="text-4xl font-semibold xl:text-6xl" set:html={title} />
      {description && <p class="text-2xl lg:col-start-1 xl:text-3xl" set:html={description} />}
      <p
        class="flex flex-col gap-2 self-start font-mono text-xs uppercase tracking-normal opacity-70 lg:col-start-2 lg:row-start-2 xl:text-sm"
      >
        <span>Updated on <Time datetime={contentModifiedDate} /></span>
      </p>
    </header>

    <!-- Legal Content -->
    <section class="prose max-w-2xl prose-headings:font-semibold [&_a]:text-zmoki-azure-500">
      <slot />
    </section>
  </section>

  <script is:inline>
    document.querySelectorAll('a[href^="mailto:"]').forEach(function (el) {
      el.addEventListener("click", function () {
        window.posthog?.capture("contact_email_clicked", {
          email: this.getAttribute("href").replace("mailto:", ""),
        });
      });
    });
  </script>
</BaseLayout>
