---
import { getCollection, getEntry, render, type CollectionEntry } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("feed");
  return posts.map((post: CollectionEntry<"feed">) => ({
    params: { slug: post.id },
    props: post,
  }));
}

const post = Astro.props as CollectionEntry<"feed">;
const { Content } = await render(post);

// 16:9 SVG master of the post's card, rasterized to responsive webp by
// astro:assets. Posts without a master simply have no cover yet.
const svgMasters = import.meta.glob<{ default: ImageMetadata }>("/src/content/og/*.svg", {
  eager: true,
});
const coverImage = svgMasters[`/src/content/og/${post.id}.svg`]?.default;
const coverAlt = coverImage ? (await getEntry("og", post.id))?.data.alt : undefined;
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  publishDate={post.data.publishDate}
  contentModifiedDate={post.data.contentModifiedDate}
  coverImage={coverImage}
  coverAlt={coverAlt}
>
  <Content />
</PostLayout>

<script is:inline define:vars={{ postSlug: post.id, postTitle: post.data.title }}>
  window.posthog?.capture("post_viewed", {
    post_slug: postSlug,
    post_title: postTitle,
  });
</script>
