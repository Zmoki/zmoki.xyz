---
import { getCollection, render, type CollectionEntry } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("feed");
  return posts.map((post: CollectionEntry<"feed">) => ({
    params: { slug: post.id },
    props: post,
  }));
}

const post = Astro.props as CollectionEntry<"feed">;
const { Content } = await render(post);
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  publishDate={post.data.publishDate}
  contentModifiedDate={post.data.contentModifiedDate}
  coverImage={`/og/cover/feed/${post.id}.png`}
>
  <Content />
</PostLayout>

<script is:inline define:vars={{ postSlug: post.id, postTitle: post.data.title }}>
  window.posthog?.capture("post_viewed", {
    post_slug: postSlug,
    post_title: postTitle,
  });
</script>
