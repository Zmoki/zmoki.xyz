    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.0",
    "markdown-it": "^15.0.0",
    "posthog-js": "^1.376.5",
    "remark-definition-list": "^2.0.0",
    "sanitize-html": "^2.17.0",
    "tailwindcss": "^4.3.3",
