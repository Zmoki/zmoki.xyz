# PostHog analytics
PUBLIC_POSTHOG_PROJECT_TOKEN=
PUBLIC_POSTHOG_HOST=

# Set to "false" to disable analytics (PostHog) in dev
PUBLIC_ANALYTICS_ENABLED=

# Brevo email forms
PUBLIC_BREVO_ACCOUNT_ID=

# Cloudflare Turnstile (bot protection on forms)
PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=

# Chrome UX Report API key (server-only, no PUBLIC_ prefix). Used by the
# /api/crux Pages Function behind /marketing-engineer/inp/. Locally the dev
# server reads it from .env; in production set it as a Cloudflare Pages secret.
CRUX_API_KEY=
